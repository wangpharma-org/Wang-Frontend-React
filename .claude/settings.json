{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git fetch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npx tsc --noEmit*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(gh repo delete *)"
    ]
  }
}
